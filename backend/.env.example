# Home Network Control Center — Configuração do Servidor
# Copie este arquivo para .env e ajuste conforme necessário

# Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Segurança — ALTERE ESTA CHAVE! (use: python -c "import secrets;print(secrets.token_urlsafe(32))")
SECRET_KEY=

# Tokens (em minutos / dias)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Banco de Dados
DATABASE_URL=sqlite+aiosqlite:///./data/hncc.db

# Scanner de Rede
SCAN_INTERVAL_MINUTES=5
ARP_SCAN_TIMEOUT=3
NMAP_PATH=nmap

# Compartilhamento de Arquivos
SHARES_ROOT=./shares
MAX_UPLOAD_SIZE_MB=2048

# Mídia
FFMPEG_PATH=ffmpeg
THUMBNAIL_CACHE_DIR=./cache/thumbnails
